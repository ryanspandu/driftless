SESSION_DRIVER=memory
DATABASE_URL=sqlite://test
SEED_ADMIN_EMAIL=admin@driftless.local
SEED_ADMIN_PASSWORD="Driftless#333"
SEED_ADMIN_USERNAME=johndoe
APP_KEY=test-app-key-must-be-32-chars-min!!
APP_URL=http://localhost:3333
PORT=3333
HOST=localhost
LOG_LEVEL=silent

# In-process limiter so the suite never needs a live Redis. Without this the
# value falls through to the developer's .env (typically `redis`) and the
# throttles on the auth routes would make tests depend on external state.
LIMITER_STORE=memory

# No background worker under test: handlers are exercised directly, and a queue
# would make the suite depend on a live Redis.
QUEUE_ENABLED=false
