TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info
APP_KEY=change-me-run-node-ace-generate-key
# Only set while rotating APP_KEY: the outgoing key, kept so ciphertext written
# under it (integration secrets, payment credentials) stays readable until it has
# been re-encrypted. Remove once rotation is complete.
APP_KEY_PREVIOUS=
APP_URL=http://localhost:3333

# Which upstream addresses may set X-Forwarded-For (passed to proxy-addr).
# Decides what request.ip() returns, and therefore whether IP-based rate limits
# work at all. Behind a load balancer or CDN, set this to the real topology
# (e.g. "uniquelocal" or a CIDR) instead of the "loopback" default.
TRUST_PROXY=loopback

SESSION_DRIVER=cookie

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/driftless

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

MEDIA_STORAGE_PATH=./storage/media
MEDIA_URL_PREFIX=/media

SEED_ADMIN_EMAIL=admin@driftless.local
SEED_ADMIN_PASSWORD="Driftless#333"
SEED_ADMIN_USERNAME=johndoe
# Set to 1 to refresh the seeded admin password when the user already exists (dev only)
FORCE_SEED_PASSWORD=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

GA4_MEASUREMENT_ID=
CLARITY_PROJECT_ID=

# Offline/PWA kill switch. Set to 1 to disable offline features; leave unset/empty to enable.
# Vite injects this into the client as `import.meta.env.VITE_DISABLE_OFFLINE` (see vite.config.ts).
DISABLE_OFFLINE=1

# Rate limiter for the external /api/v1 API. Store: 'redis' (needs Redis) or 'memory' (per-process).
LIMITER_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Background jobs (BullMQ on Redis db 1). Run the worker with: node ace queue:work
# Set to false to disable queuing entirely — callers then fall back to their
# synchronous path, so the app still works, emails just send in-request.
QUEUE_ENABLED=true

# Outgoing mail. These are the FALLBACK — SMTP configured from
# Settings → Email is stored encrypted in the database and takes precedence.
# Leave SMTP_HOST empty and email is simply "not configured": sends fail with a
# clear message rather than silently going nowhere.
SMTP_HOST=
SMTP_PORT=587
# true only for implicit TLS (port 465); STARTTLS on 587 is negotiated anyway.
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@driftless.local
MAIL_FROM_NAME=Driftless
