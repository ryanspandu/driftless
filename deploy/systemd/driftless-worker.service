[Unit]
Description=Driftless queue worker
After=driftless.service

[Service]
Type=simple
User=driftless
WorkingDirectory=/opt/driftless
ExecStart=/usr/bin/node current/bin/console.js queue:work
Environment=NODE_ENV=production
Restart=always
RestartSec=5

# The worker drains in-flight jobs on SIGTERM. Killing it sooner means a
# half-processed job is redelivered and its handler runs twice.
TimeoutStopSec=20
KillMode=mixed

[Install]
WantedBy=multi-user.target
