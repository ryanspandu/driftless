@layout('emails/layout')

@section('content')
  <h1 style="margin:0 0 8px 0; font-size:20px; font-weight:600;">You left something behind</h1>
  <p style="margin:0 0 24px 0; color:#52525b;">
    Your basket is still here if you want it.
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
    @each(item in items)
      <tr>
        <td style="padding:8px 0; border-bottom:1px solid #f4f4f5; font-size:14px;">
          {{ item.title }}
          @if(item.variantTitle)
            <span style="color:#71717a;">· {{ item.variantTitle }}</span>
          @end
          <span style="color:#71717a;">× {{ item.quantity }}</span>
        </td>
        <td style="padding:8px 0; border-bottom:1px solid #f4f4f5; font-size:14px; text-align:right; white-space:nowrap;">
          {{ item.total }}
        </td>
      </tr>
    @end
    <tr>
      <td style="padding:12px 0 0 0; font-size:15px; font-weight:600;">Total</td>
      <td style="padding:12px 0 0 0; font-size:15px; font-weight:600; text-align:right;">{{ total }}</td>
    </tr>
  </table>

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:32px 0 0 0;">
    <tr>
      <td style="background-color:#18181b; border-radius:8px;">
        <a href="{{ cartUrl }}" style="display:inline-block; padding:12px 20px; font-size:14px; font-weight:500; color:#ffffff; text-decoration:none;">
          Back to your basket
        </a>
      </td>
    </tr>
  </table>

  {{--
    The opt-out is required, not decorative. This message is marketing — nobody
    asked for it — so it has to carry a way out that needs no account.
  --}}
  <p style="margin:32px 0 0 0; font-size:12px; color:#a1a1aa;">
    Don't want these?
    <a href="{{ unsubscribeUrl }}" style="color:#71717a;">Unsubscribe</a>.
  </p>
@end
