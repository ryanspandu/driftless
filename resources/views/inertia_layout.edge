<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {{-- Warm the Google Fonts connections early so the font stylesheet + files
        (loaded later by the theme/kit <link>s) don't pay a fresh TLS handshake —
        cuts the render-blocking font cost. Harmless when a page uses no web font. --}}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {{-- Web-font stylesheets are rendered `media="print"` (fetched but NOT
        render-blocking); once the DOM is ready, flip them to `all` so the font
        applies without ever having delayed first paint. Nonce'd, so it passes
        the strict prod CSP. `font-display:swap` covers the brief fallback. --}}
    <script nonce="{{ cspNonce ?? '' }}">
      addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('link[data-font-async]').forEach(function (l) { l.media = 'all' })
      })
    </script>
    {{-- Exposes the per-request CSP nonce to client JS (react-select's emotion
        cache reads it so its injected <style> elements are not blocked). --}}
    <meta name="csp-nonce" content="{{ cspNonce ?? '' }}" />
    {{-- `appName` is a view local shared by `inertia_middleware.ts` (site_meta.site_title
         on public pages, admin_branding.project_name on /admin) — read by `inertia/app.tsx`
         before Inertia's own title template runs, so " - {siteName}" reflects the
         operator's actual settings instead of a hardcoded fallback. --}}
    <meta name="app-name" content="{{ appName ?? 'Driftless' }}" />
    {{-- Same idea as `app-name` above — `titleFormat` is site_meta.title_format
         on public pages, always 'suffix' on /admin. --}}
    <meta name="title-format" content="{{ titleFormat ?? 'suffix' }}" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {{-- `faviconUrl` is a view local (not an Inertia prop) passed by public
         renders via `renderPage`'s third argument, so the icon is right in the
         initial HTML — no client JS swap needed. Admin/auth/error pages don't
         pass it, so they keep the static default. No hardcoded `type`: the
         operator can upload png/jpg/svg/webp, not just svg. --}}
    <link rel="icon" href="{{ faviconUrl ?? '/logo.svg' }}" />
    <link rel="apple-touch-icon" href="{{ faviconUrl ?? '/logo.svg' }}" />
    <meta name="theme-color" content="#111827" />
    {{-- No hardcoded <title> here: Inertia's <Head title> (via @inertiaHead)
         owns it. A static title in the shell rendered a SECOND <title> on SSR
         pages (the shell's + Inertia's), so the public HTML carried two. --}}

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  {{--
    `.theme-light` pins the admin dark/light toggle out for every non-admin
    page (see `@custom-variant dark` and `.theme-light` in app.css) — but only
    on a DESCENDANT wrapper that LayoutShell renders client-side. <body> itself
    sits above that wrapper and still gets its own `bg-background`/`color` from
    `body { @apply bg-background text-foreground }` in app.css, which DOES react
    to the admin's `.dark` class on <html> — so the page's own gutters (behind
    a narrower card, or during overscroll) briefly showed the admin's dark
    background on an otherwise light public/storefront page. Mirrors
    LayoutShell's own classification (`inertia/components/layout-shell.tsx`) so
    the two never drift: everything except admin/auth pages is `.theme-light`.
  --}}
  @let(pageComponent = page.component ?? '')
  @let(componentSegments = pageComponent.split('/'))
  @let(isAdminOrAuthPage = pageComponent.startsWith('admin/') || pageComponent.startsWith('auth/') || (componentSegments[0] === 'modules' && componentSegments[2] === 'admin'))
  <body class="{{ isAdminOrAuthPage ? '' : 'theme-light' }}">
    @inertia()
  </body>
</html>
