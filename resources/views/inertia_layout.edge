<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {{-- Warm the Google Fonts connections early so the font stylesheet + files
        (loaded later by the theme/kit <link>s) don't pay a fresh TLS handshake —
        cuts the render-blocking font cost. Harmless when a page uses no web font. --}}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {{-- Web-font stylesheets are rendered `media="print"` (fetched but NOT
        render-blocking); once the DOM is ready, flip them to `all` so the font
        applies without ever having delayed first paint. Nonce'd, so it passes
        the strict prod CSP. `font-display:swap` covers the brief fallback. --}}
    <script nonce="{{ cspNonce ?? '' }}">
      addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('link[data-font-async]').forEach(function (l) { l.media = 'all' })
      })
    </script>
    {{-- Exposes the per-request CSP nonce to client JS (react-select's emotion
        cache reads it so its injected <style> elements are not blocked). --}}
    <meta name="csp-nonce" content="{{ cspNonce ?? '' }}" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {{-- `faviconUrl` is a view local (not an Inertia prop) passed by public
         renders via `renderPage`'s third argument, so the icon is right in the
         initial HTML — no client JS swap needed. Admin/auth/error pages don't
         pass it, so they keep the static default. No hardcoded `type`: the
         operator can upload png/jpg/svg/webp, not just svg. --}}
    <link rel="icon" href="{{ faviconUrl ?? '/logo.svg' }}" />
    <link rel="apple-touch-icon" href="{{ faviconUrl ?? '/logo.svg' }}" />
    <meta name="theme-color" content="#111827" />
    {{-- No hardcoded <title> here: Inertia's <Head title> (via @inertiaHead)
         owns it. A static title in the shell rendered a SECOND <title> on SSR
         pages (the shell's + Inertia's), so the public HTML carried two. --}}

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>
</html>
