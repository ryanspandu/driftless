// Type-checks module front-end code under modules/<name>/ui using the client
// preset, so JSX / React / DOM types are available and "~/*" resolves to the
// shared Inertia codebase. The server build (root tsconfig) excludes these files.
{
  "extends": "@adonisjs/tsconfig/tsconfig.client.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "~/*": ["../inertia/*"],
      "@generated/*": ["../.adonisjs/client/*"]
    }
  },
  // Module UI resolves `~/*` into the Inertia codebase, so it depends on that
  // codebase's ambient declarations (e.g. `declare module 'react-google-recaptcha'`
  // in inertia/types) once an import chain reaches a module that needs them.
  "include": ["./*/ui/**/*.ts", "./*/ui/**/*.tsx", "../inertia/types/**/*.d.ts"]
}
