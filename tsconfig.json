{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "jsx": "react",
    "outDir": "./build",
    // Lets a handful of relative imports use the literal .ts extension (see
    // app/services/media_service.ts) instead of the .js convention — needed
    // alongside the already-enabled rewriteRelativeImportExtensions so tsc's
    // type-checker (not just the ts-exec runtime loader) accepts the syntax.
    "allowImportingTsExtensions": true
  },
  "references": [{ "path": "./tsconfig.inertia.json" }],
  "exclude": [
    "inertia/**",
    "node_modules/**",
    "build/**",
    "bower_components/**",
    "jspm_packages/**",
    "modules/**/ui/**",
    "modules/**/server/**"
  ]
}
